FROM python:3.9-slim AS builder

# Avoid prompts & enable faster pip
ENV PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# --- System build dependencies ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# --- Install Python dependencies to wheel cache ---
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Add build-time arguments so each developer can bake values if preferred
ARG DB_HOST=127.0.0.1
ARG DB_PORT=5432
ARG DB_USER=liquicity_user
ARG DB_PASSWORD=Liquicity2025!
ARG DB_NAME=liquicity_db

ARG BRIDGE_API_KEY=
ARG BRIDGE_API_URL=https://api.bridge.xyz/v0
ARG APP_ENV=development
ARG DEBUG=true

# Provide defaults via ENV (can be overridden at runtime)
ENV DB_HOST=${DB_HOST} \
    DB_PORT=${DB_PORT} \
    DB_USER=${DB_USER} \
    DB_PASSWORD=${DB_PASSWORD} \
    DB_NAME=${DB_NAME} \
    BRIDGE_API_KEY=${BRIDGE_API_KEY} \
    BRIDGE_API_URL=${BRIDGE_API_URL} \
    ENVIRONMENT=${APP_ENV} \
    DEBUG=${DEBUG}

# ---------------- Runtime stage ----------------
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Runtime utilities
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Install dependencies from wheels
COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache /wheels/* && rm -rf /wheels

# Copy application code
COPY clean_backend/ ./clean_backend/
COPY alembic.ini .

USER appuser
EXPOSE 8000

# Healthcheck (relies on curl installed above)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "clean_backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"] 