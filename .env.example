# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liquicity

# Application Settings
APP_URL=http://localhost:3000
TESTING=1

# Security Service
SECURITY_SERVICE_URL=http://localhost:8080

# Authentication
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://your-api

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60

# Session Management
SESSION_EXPIRY_MINUTES=30
MFA_EXPIRY_MINUTES=15

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liquicity

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Monitoring
NEW_RELIC_LICENSE_KEY=your-new-relic-key
NEW_RELIC_APP_NAME=liquicity-security-service

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Error Reporting
SENTRY_DSN=https://your-sentry-dsn@app.getsentry.com/123456

# Security
SECURE_COOKIES=true
HTTPS_ONLY=true
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Authentication
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Providers
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Modern Treasury (Payment provider for US)
MODERN_TREASURY_API_KEY=your-modern-treasury-api-key
MODERN_TREASURY_ORG_ID=your-modern-treasury-org-id

# Rapyd (Payment provider for international)
RAPYD_ACCESS_KEY=your-rapyd-access-key
RAPYD_SECRET_KEY=your-rapyd-secret-key

# Circle (Stablecoin provider)
CIRCLE_API_KEY=your-circle-api-key

# Web3 & Blockchain
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-key
WALLET_PRIVATE_KEY=your-private-key-for-gas-fees

# AI Services (Optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key 